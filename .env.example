# Copy this file to .env and paste each key after the = sign. .env is never uploaded.
# Lines left empty are skipped. See SETUP.md for where each key comes from.

# Step 2: needed for the first real video
GEMINI_API_KEY=
PIXABAY_API_KEY=
# Step 2: optional backups (Pexels paused new API keys in Oct 2026)
GROQ_API_KEY=
PEXELS_API_KEY=

# Step 3: YouTube (filled in by scripts/youtube_auth.py output)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Step 4: Instagram
IG_USER_ID=
IG_ACCESS_TOKEN=

# Step 5: TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_REFRESH_TOKEN=
GH_PAT=
